#!/usr/bin/env bash
# Run stoei from the current checkout — a debug build of the repo.
#
# Symlink this onto your PATH so typing `stoei` always runs the working-copy
# code (see the README "Local debug build" section):
#
#   ln -sf "$(pwd)/scripts/stoei-dev" ~/.local/bin/stoei
#
# It uses `go run`, so each launch reflects the current source (no manual
# rebuild) and is an unstripped, debuggable build. readlink -f resolves the
# symlink back to this file so the repo root is found regardless of where the
# command is invoked from.
set -euo pipefail
SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
cd "$PROJECT_ROOT"
exec go run ./cmd/stoei "$@"
