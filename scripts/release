#!/usr/bin/env bash
# Cut a release: verify a clean, gated main, then tag and push so the Release
# workflow builds and publishes the binaries.
#
#   scripts/release 0.7.11   # or v0.7.11
set -euo pipefail

VERSION="${1:?usage: scripts/release <version> (e.g. 0.7.11)}"
VERSION="v${VERSION#v}"

cd "$(git rev-parse --show-toplevel)"

[[ -z "$(git status --porcelain)" ]] || { echo "error: working tree not clean" >&2; exit 1; }
branch="$(git rev-parse --abbrev-ref HEAD)"
[[ "$branch" == "main" ]] || { echo "error: on '$branch'; release from main" >&2; exit 1; }
git fetch origin main
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] ||
	{ echo "error: HEAD is not in sync with origin/main" >&2; exit 1; }
if git rev-parse -q --verify "refs/tags/$VERSION" >/dev/null; then
	echo "error: tag $VERSION already exists" >&2
	exit 1
fi

cargo fmt --all -- --check
cargo clippy --all-targets --locked -- -D warnings
cargo test --all-targets --locked
cargo build --release --locked

git tag -a "$VERSION" -m "$VERSION"
git push origin "$VERSION"
echo "Pushed $VERSION — the Release workflow is publishing it (gh run watch to follow)."
